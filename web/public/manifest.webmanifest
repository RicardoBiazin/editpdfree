{
  "name": "EditPDFree",
  "short_name": "EditPDFree",
  "description": "Editor de PDF gratuito e de código aberto. Seus arquivos não saem do seu computador.",
  "lang": "pt-BR",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#eef0f3",
  "theme_color": "#c62828",
  "icons": [
    { "src": "/icons/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icone-mascaravel-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icone.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "/", "accept": { "application/pdf": [".pdf"] } }
  ]
}
